{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: 配置 Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "STM32: 编译 Debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--parallel",
                "2"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "STM32: 配置 Debug",
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "STM32: 编译并烧录",
            "type": "process",
            "command": "openocd",
            "args": [
                "-f",
                "${workspaceFolder}/.vscode/openocd.cfg",
                "-c",
                "program \"${workspaceFolder}/build/Debug/balance_car.elf\" verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "STM32: 编译 Debug",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
